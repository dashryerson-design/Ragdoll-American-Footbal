rules_version = '2';
// PAF accounts: Cloud Firestore security rules (enforced by Google's servers).
// Data model
//   usernames/{name}                       {uid}                         unique username claim; the document ID is the name
//   users/{uid}                            {username, createdAt, schema, privacyVer}
//   users/{uid}/careers/{slot}             career head: summary + sync control; slot is "0".."4" (the five cloud careers)
//   users/{uid}/careers/{slot}/parts/{id}  {d}: one piece of the career save; id = <generation>_<part>_<index>; immutable
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function verified() { return request.auth.token.email_verified == true; }
    function validName(n) { return n is string && n.matches('^[a-z0-9_]{3,16}$'); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function namePath(n) { return /databases/$(database)/documents/usernames/$(n); }

    // ---- usernames: claimed once, only for yourself, only together with your own user document
    match /usernames/{name} {
      allow get: if signedIn();   // look up a friend by username (a username only maps to a uid)
      allow list: if false;
      allow create: if signedIn() && validName(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.username == name;
      allow update: if false;
      // released only by its owner, and only when their user document no longer points at it (rename or account deletion)
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(userPath(request.auth.uid)) || getAfter(userPath(request.auth.uid)).data.username != name);
    }

    // ---- account profile: private to its owner
    match /users/{uid} {
      function validUser(d) {
        return d.keys().hasOnly(['username', 'createdAt', 'schema', 'privacyVer'])
          && d.keys().hasAll(['username', 'createdAt', 'schema', 'privacyVer'])
          && validName(d.username) && d.createdAt is timestamp && d.schema is int && d.privacyVer is int;
      }
      function ownsName(n) { return getAfter(namePath(n)).data.uid == uid; }
      allow get: if isUser(uid);
      allow list: if false;
      allow create: if isUser(uid) && validUser(request.resource.data) && ownsName(request.resource.data.username);
      allow update: if isUser(uid) && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.username == resource.data.username || ownsName(request.resource.data.username));
      allow delete: if isUser(uid);

      // ---- cloud careers: exactly five fixed slots, writes need a verified email, every write advances the revision by one
      match /careers/{slot} {
        function slotOk() { return slot in ['0', '1', '2', '3', '4']; }
        function validHead(d) {
          return d.keys().hasOnly(['careerId', 'rev', 'gen', 'parts', 'fmt', 'gameVer', 'sum', 'updatedAt', 'device', 'replaced'])
            && d.keys().hasAll(['careerId', 'rev', 'gen', 'parts', 'fmt', 'gameVer', 'sum', 'updatedAt'])
            && d.careerId is string && d.careerId.size() <= 40
            && d.rev is int && d.gen is string && d.gen.matches('^[A-Za-z0-9]{8,32}$')
            && d.parts is list && d.parts.size() >= 1 && d.parts.size() <= 64
            && d.fmt is int && d.gameVer is string && d.gameVer.size() <= 12
            && d.sum is map && d.sum.size() <= 16 && d.updatedAt == request.time
            && (!('replaced' in d) || d.replaced is bool);
        }
        allow read: if isUser(uid) && slotOk();
        allow create: if isUser(uid) && verified() && slotOk()
          && validHead(request.resource.data) && request.resource.data.rev == 1;
        allow update: if isUser(uid) && verified() && slotOk()
          && validHead(request.resource.data)
          && request.resource.data.rev == resource.data.rev + 1
          // a different career may take the slot only as an explicit replacement (one atomic update, so the old one stays until it commits)
          && (request.resource.data.careerId == resource.data.careerId || request.resource.data.replaced == true);
        allow delete: if isUser(uid);

        match /parts/{part} {
          allow read: if isUser(uid) && slotOk();
          allow create: if isUser(uid) && verified() && slotOk()
            && part.matches('^[A-Za-z0-9]{8,32}_[a-z]{3,8}_[0-9]{1,2}$')
            && request.resource.data.keys().hasOnly(['d'])
            && request.resource.data.d is string && request.resource.data.d.size() <= 360000;
          allow update: if false;
          allow delete: if isUser(uid);
        }
      }
    }

    // ---- online test rooms: a WebRTC offer from a verified host, answered once by another verified player; deleted by the host once joined
    match /rooms/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && verified() && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['host', 'offer', 'v', 'at'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.offer is string && request.resource.data.offer.size() <= 20000
        && request.resource.data.v is string && request.resource.data.v.size() <= 12 && request.resource.data.at == request.time;
      allow update: if signedIn() && verified() && !('guest' in resource.data) && request.auth.uid != resource.data.host
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'answer'])
        && request.resource.data.guest == request.auth.uid
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 20000;
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }

    // ---- friends. Public profile: username + join date + game totals + avatar / calling card ids, nothing private; written only by its owner, matching their account
    function pair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function uname(uid) { return get(userPath(uid)).data.username; }
    function docPath(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isUser(uid) && request.resource.data.keys().hasOnly(['username', 'joined', 'stats', 'avatar', 'card', 'acct'])
        && (!('acct' in request.resource.data) || request.resource.data.acct is map && request.resource.data.acct.size() <= 6)
        && request.resource.data.username == uname(uid) && request.resource.data.joined == get(userPath(uid)).data.createdAt
        && request.resource.data.stats is map && request.resource.data.stats.size() <= 4
        && (!('avatar' in request.resource.data) || request.resource.data.avatar is string && request.resource.data.avatar.matches('^[a-z0-9-]{1,16}$'))
        && (!('card' in request.resource.data) || request.resource.data.card is string && request.resource.data.card.matches('^[a-z0-9-]{1,16}$'));   // avatar + calling card: ids of built-in designs, nothing uploaded
      allow delete: if isUser(uid);
    }
    // friend request {from}_{to}: one per pair and direction, not to yourself, not to a friend, not if they already asked you
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && verified() && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'at'])
        && request.resource.data.from == request.auth.uid && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to && exists(userPath(request.resource.data.to))
        && request.resource.data.fromName == uname(request.auth.uid) && request.resource.data.toName == uname(request.resource.data.to)
        && !exists(docPath('friendships', pair(request.auth.uid, request.resource.data.to)))
        && !exists(docPath('requests', request.resource.data.to + '_' + request.auth.uid)) && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    // friendship: created only by the person who received the request (the request must exist), with both real usernames
    function otherOf(u) { return u[0] == request.auth.uid ? u[1] : u[0]; }
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['users', 'names', 'at'])
        && request.resource.data.users is list && request.resource.data.users.size() == 2 && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1] && id == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && exists(docPath('requests', otherOf(request.resource.data.users) + '_' + request.auth.uid))
        && request.resource.data.names.size() == 2 && request.resource.data.names[request.auth.uid] == uname(request.auth.uid)
        && request.resource.data.names[otherOf(request.resource.data.users)] == uname(otherOf(request.resource.data.users)) && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }
    // match invite {to}_{from}: only between friends, carries the room code; deleted when answered
    match /invites/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create, update: if signedIn() && verified() && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'mode', 'code', 'at'])
        && request.resource.data.from == request.auth.uid && id == request.resource.data.to + '_' + request.auth.uid
        && exists(docPath('friendships', pair(request.auth.uid, request.resource.data.to)))
        && request.resource.data.mode in ['runs', 'exh'] && request.resource.data.code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.fromName == uname(request.auth.uid) && request.resource.data.at == request.time;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ---- Account Level: one XP total per account. It only grows, by at most 5000 per write, at most one write every 20 s
    // (a modified browser cannot jump levels); equipped cosmetics are a small map of ids that may change any time
    match /progress/{uid} {
      function okEq(d) { return d.keys().hasOnly(['xp', 'eq', 't']) && d.xp is int && d.eq is map && d.eq.size() <= 20; }
      allow get: if isUser(uid);
      allow list: if false;
      allow create: if isUser(uid) && okEq(request.resource.data) && request.resource.data.xp == 0 && request.resource.data.t == request.time;
      allow update: if isUser(uid) && okEq(request.resource.data)
        && ((request.resource.data.xp == resource.data.xp && request.resource.data.t == resource.data.t)
          || (request.resource.data.xp > resource.data.xp && request.resource.data.xp - resource.data.xp <= 5000
              && request.resource.data.t == request.time && request.time > resource.data.t + duration.value(20, 's')));
      allow delete: if isUser(uid);
    }

    // everything else: closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
